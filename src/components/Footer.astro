---
import { services } from '../data/services';
import { EMAIL, SOCIAL_LINKS, mailto, withBase } from '../data/site';

const year = new Date().getFullYear();
// Social links without a URL yet are hidden (see SOCIAL_LINKS in src/data/site.ts).
const socials = SOCIAL_LINKS.filter((link) => link.href);
---

<footer class="site-footer on-dark">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <p class="wordmark">THE CLARITY</p>
      <p class="tagline">Clarity through strategy. Growth through intention.</p>
    </div>

    <nav class="site-footer__col" aria-label="Services">
      <p class="col-heading">Services</p>
      {services.map((service) => (
        <a href={withBase(`services/${service.slug}/`)}>{service.navLabel}</a>
      ))}
    </nav>

    <div class="site-footer__col">
      <p class="col-heading">Contact</p>
      <a href={mailto()}>{EMAIL}</a>
      <span class="muted">London, UK</span>
    </div>

    {socials.length > 0 && (
      <div class="site-footer__col">
        <p class="col-heading">Follow</p>
        {socials.map((link) => (
          <a href={link.href} rel="noopener">{link.label}</a>
        ))}
      </div>
    )}
  </div>

  <div class="wrap site-footer__bottom">
    <hr class="rule" />
    <p class="fine-print">&copy; {year} The Clarity. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-deep-clarity);
    color: var(--color-clarity-white);
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .site-footer__inner {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    padding-bottom: 3rem;
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      /* Brand column, then one equal column per link group (Follow appears
         once social links are added). */
      grid-template-columns: 2fr;
      grid-auto-columns: 1fr;
      grid-auto-flow: column;
    }
  }

  .site-footer .wordmark {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    margin: 0 0 0.75rem;
  }

  .tagline {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-clear-sage);
    max-width: 24ch;
  }

  .col-heading {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-clear-sage);
    margin: 0 0 0.9rem;
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .site-footer__col a {
    text-decoration: none;
    color: var(--color-clarity-white);
    font-size: 0.9rem;
  }

  .site-footer__col a:hover {
    color: var(--color-warm-ochre);
  }

  .muted {
    color: rgba(248, 247, 242, 0.6);
    font-size: 0.9rem;
  }

  .site-footer__bottom .rule {
    border-top-color: rgba(248, 247, 242, 0.2);
    opacity: 1;
    margin-bottom: 1.5rem;
  }

  .fine-print {
    font-size: 0.78rem;
    color: rgba(248, 247, 242, 0.55);
    padding-bottom: 2rem;
  }
</style>
