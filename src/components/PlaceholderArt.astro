---
// -----------------------------------------------------------------------
// PlaceholderArt.astro
// -----------------------------------------------------------------------
// TEMPORARY stand-in for the founder photo in the About section. It shows a
// tone-on-tone geometric motif with a visible "Placeholder" tag, rather than
// a stock photo of a person.
//
// TO REPLACE WITH THE REAL PHOTO: follow the "Founder photo" steps in
// IMAGES.md, then delete this component once nothing references it.
// -----------------------------------------------------------------------

interface Props {
  ratio?: string; // e.g. '4 / 5'
  label?: string; // accessible description of what will go here
}

const { ratio = '4 / 5', label = 'Image placeholder' } = Astro.props;
---

<div class="placeholder-art" style={`aspect-ratio: ${ratio};`} role="img" aria-label={label}>
  <svg viewBox="0 0 400 500" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <rect width="400" height="500" class="pa-bg" />
    <line x1="200" y1="0" x2="200" y2="500" class="pa-line" />
    <line x1="0" y1="250" x2="400" y2="250" class="pa-line" />
    <line x1="0" y1="0" x2="400" y2="500" class="pa-line pa-line--diagonal" />
    <rect x="40" y="60" width="320" height="380" class="pa-frame" />
  </svg>
  <span class="placeholder-art__tag" aria-hidden="true">Placeholder</span>
</div>

<style>
  .placeholder-art {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .placeholder-art svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pa-bg {
    fill: var(--color-muted-moss);
  }

  .pa-line,
  .pa-frame {
    stroke: var(--color-clarity-white);
    stroke-width: 1;
    opacity: 0.3;
  }

  .pa-line--diagonal {
    opacity: 0.15;
  }

  .pa-frame {
    fill: none;
    stroke-width: 1.5;
  }

  .placeholder-art__tag {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-clarity-white);
    background: rgba(38, 51, 47, 0.55);
    padding: 0.3em 0.6em;
    border-radius: var(--radius-sm);
    pointer-events: none;
  }
</style>
