---
// -----------------------------------------------------------------------
// PlaceholderArt.astro
// -----------------------------------------------------------------------
// TEMPORARY placeholder visual used until real photography is dropped in.
// It renders a tone-on-tone geometric "light through glass" motif instead
// of a stock photo of people/offices (see brand imagery guidelines).
//
// TO REPLACE WITH A REAL IMAGE:
//   1. Add your photo to /public/images/ (see /public/images/README.md)
//   2. Swap the <PlaceholderArt ... /> usage for a plain <img>, e.g.
//        <img src={`${import.meta.env.BASE_URL}images/hero.jpg`}
//             alt="Describe the photo" width="1600" height="2000" loading="lazy" />
//   3. Delete this component once nothing references it.
// -----------------------------------------------------------------------

interface Props {
  variant?: 'hero' | 'window' | 'abstract' | 'portrait';
  ratio?: string; // e.g. '4 / 5'
  label?: string; // short internal note, not shown to visitors
  class?: string;
}

const { variant = 'window', ratio = '4 / 5', label = 'placeholder', class: className = '' } = Astro.props;
---

<div class={`placeholder-art placeholder-art--${variant} ${className}`} style={`aspect-ratio: ${ratio};`} role="img" aria-label={label}>
  <svg viewBox="0 0 400 500" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <rect width="400" height="500" class="pa-bg" />
    <line x1="200" y1="0" x2="200" y2="500" class="pa-line" />
    <line x1="0" y1="250" x2="400" y2="250" class="pa-line" />
    <line x1="0" y1="0" x2="400" y2="500" class="pa-line pa-line--diagonal" />
    <rect x="40" y="60" width="320" height="380" class="pa-frame" />
  </svg>
  <span class="placeholder-art__tag">Placeholder</span>
</div>

<style>
  .placeholder-art {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .placeholder-art svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pa-bg {
    fill: var(--color-soft-stone);
  }

  .pa-line {
    stroke: var(--color-muted-moss);
    stroke-width: 1;
    opacity: 0.35;
  }

  .pa-line--diagonal {
    opacity: 0.15;
  }

  .pa-frame {
    fill: none;
    stroke: var(--color-clear-sage);
    stroke-width: 1.5;
    opacity: 0.6;
  }

  .placeholder-art--hero .pa-bg {
    fill: var(--color-deep-clarity);
  }
  .placeholder-art--hero .pa-line,
  .placeholder-art--hero .pa-frame {
    stroke: var(--color-clear-sage);
    opacity: 0.5;
  }

  .placeholder-art--abstract .pa-bg {
    fill: var(--color-clear-sage);
  }
  .placeholder-art--abstract .pa-line,
  .placeholder-art--abstract .pa-frame {
    stroke: var(--color-deep-clarity);
    opacity: 0.25;
  }

  .placeholder-art--portrait .pa-bg {
    fill: var(--color-muted-moss);
  }
  .placeholder-art--portrait .pa-line,
  .placeholder-art--portrait .pa-frame {
    stroke: var(--color-clarity-white);
    opacity: 0.3;
  }

  .placeholder-art__tag {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-clarity-white);
    background: rgba(38, 51, 47, 0.55);
    padding: 0.3em 0.6em;
    border-radius: var(--radius-sm);
    pointer-events: none;
  }
</style>
