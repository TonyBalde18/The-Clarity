---
import Photo from './Photo.astro';
import heroImage from '../assets/images/hero-architecture-light.jpg';
import { withBase } from '../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Business Consultancy — UK</p>
      <h1 id="hero-heading">Make your business<br />make sense.</h1>
      <p class="hero__sub">
        For service-based founders who've outgrown the way they've been running their
        business. We bring clarity to the strategy, structure and systems behind it, so
        you can grow without creating more complexity.
      </p>
      <a class="btn btn-primary" href={withBase('#contact')}>Work with us</a>
    </div>

    <div class="hero__art">
      <Photo
        src={heroImage}
        alt="Clean white architectural lines casting soft, rhythmic shadows in natural light"
        ratio="4 / 5"
        sizes="(min-width: 62rem) 40vw, 100vw"
        priority
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: var(--space-section);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__copy h1 {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    margin-block: 1.1rem 1.5rem;
  }

  .hero__sub {
    max-width: 44ch;
    font-size: 1.05rem;
    color: var(--color-muted-moss);
    margin-bottom: 2.25rem;
  }

  @media (min-width: 62rem) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .hero__art {
      order: 2;
    }
  }
</style>
