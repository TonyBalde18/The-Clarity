---
// -----------------------------------------------------------------------
// Photo.astro
// -----------------------------------------------------------------------
// Optimised, responsive photo. Astro generates AVIF + WebP (with a JPEG
// fallback) at several widths at build time, and the fixed aspect ratio
// reserves space so nothing shifts while the image loads.
//
// Source images live in src/assets/images/ — see IMAGES.md for credits and
// how to swap them.
// -----------------------------------------------------------------------
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string; // CSS aspect-ratio, e.g. '4 / 5'
  sizes?: string;
  /** Set on above-the-fold images only; everything else lazy-loads. */
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  ratio = '4 / 5',
  sizes = '(min-width: 62rem) 40vw, 100vw',
  priority = false,
  class: className = '',
} = Astro.props;

const widths = [480, 800, 1200, 1600].filter((w) => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={72}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={`photo ${className}`}
  style={`aspect-ratio: ${ratio};`}
/>

<style is:global>
  img.photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--color-soft-stone);
  }
</style>
