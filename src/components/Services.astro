---
const services = [
  {
    name: 'Strategy',
    body: 'Clear direction for confident decision-making.',
  },
  {
    name: 'Systems',
    body: 'Practical systems that make the business easier to run.',
  },
  {
    name: 'Brand',
    body: 'Strong positioning, communication and visual identity.',
  },
  {
    name: 'Growth',
    body: 'Sustainable growth that increases profit and freedom.',
  },
]
---

<section class="section services" id="services" aria-labelledby="services-heading">
  <div class="wrap">
    <p class="eyebrow">Services</p>
    <h2 id="services-heading">Where we help.</h2>

    <ul class="services__list">
      {services.map((service) => (
        <li class="services__item">
          <h3>{service.name}</h3>
          <p>{service.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services h2 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-block: 1rem clamp(2.5rem, 6vw, 4.5rem);
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .services__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .services__item {
    padding: 2rem 1.75rem 2rem 0;
    border-top: 1px solid var(--color-deep-clarity);
  }

  @media (min-width: 48rem) {
    .services__item {
      border-right: 1px solid rgba(38, 51, 47, 0.15);
      padding-right: 1.75rem;
    }
    .services__item:last-child {
      border-right: none;
    }
  }

  .services__item h3 {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted-moss);
    margin-bottom: 1rem;
  }

  .services__item p {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.3;
  }
</style>
