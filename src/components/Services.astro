---
import { services } from '../data/services';
import { withBase } from '../data/site';
---

<section class="section services" id="services" aria-labelledby="services-heading">
  <div class="wrap">
    <p class="eyebrow">Services</p>
    <h2 id="services-heading">Where we help.</h2>

    <ul class="services__list">
      {services.map((service) => (
        <li class="services__item">
          <a class="services__link" href={withBase(`services/${service.slug}/`)}>
            <h3>{service.title}</h3>
            <p>{service.cardSummary}</p>
            <span class="services__more" aria-hidden="true">Find out more <span class="services__arrow">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services h2 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-block: 1rem clamp(2.5rem, 6vw, 4.5rem);
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .services__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .services__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .services__item {
    border-top: 1px solid var(--color-deep-clarity);
  }

  .services__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.75rem 2rem 0;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 40rem) {
    .services__item:nth-child(odd) {
      border-right: 1px solid rgba(38, 51, 47, 0.15);
    }
    .services__item:nth-child(even) .services__link {
      padding-left: 1.75rem;
    }
  }

  @media (min-width: 62rem) {
    .services__item {
      border-right: 1px solid rgba(38, 51, 47, 0.15);
    }
    .services__item:last-child {
      border-right: none;
    }
    .services__item + .services__item .services__link {
      padding-left: 1.75rem;
    }
  }

  .services__item h3 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--color-muted-moss);
    margin-bottom: 1rem;
    min-height: 2.4rem;
  }

  .services__item p {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.3;
    margin-bottom: 1.5rem;
  }

  .services__more {
    margin-top: auto;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-deep-clarity);
  }

  .services__arrow {
    display: inline-block;
    color: var(--color-warm-ochre);
    transition: transform 0.2s ease;
  }

  .services__link:hover .services__arrow,
  .services__link:focus-visible .services__arrow {
    transform: translateX(4px);
  }

  .services__link:hover h3 {
    color: var(--color-deep-clarity);
  }
</style>
