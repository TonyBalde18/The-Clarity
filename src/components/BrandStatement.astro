---
import Photo from './Photo.astro';
import statementImage from '../assets/images/brand-statement-geometry.jpg';
---

<section class="section brand-statement on-dark" aria-labelledby="brand-statement-heading">
  <div class="wrap brand-statement__inner">
    <div class="brand-statement__art">
      <Photo
        src={statementImage}
        alt="A white architectural column catching sunlight against a dark curved wall and pale sky"
        ratio="4 / 5"
        sizes="(min-width: 62rem) 22rem, 100vw"
      />
    </div>
    <p id="brand-statement-heading" class="brand-statement__text">
      Clarity isn't about doing less.<br />
      It's about knowing what<br />
      deserves your attention.
    </p>
  </div>
</section>

<style>
  .brand-statement {
    background: var(--color-deep-clarity);
    color: var(--color-clarity-white);
  }

  .brand-statement__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .brand-statement__text {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    line-height: 1.25;
    color: var(--color-clarity-white);
  }

  .brand-statement__art {
    max-width: 22rem;
  }

  @media (min-width: 62rem) {
    .brand-statement__inner {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
</style>
