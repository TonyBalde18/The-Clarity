---
import { mailto } from '../data/site';

interface Props {
  /** Pre-filled email subject, e.g. the service the visitor was reading about. */
  subject?: string;
}

const { subject } = Astro.props;
---

<section class="section final-cta" id="contact" aria-labelledby="final-cta-heading">
  <div class="wrap final-cta__inner">
    <p class="eyebrow">Start Here</p>
    <h2 id="final-cta-heading">You don't need more noise.</h2>
    <a class="btn btn-primary" href={mailto(subject)}>Work with us</a>
  </div>
</section>

<style>
  .final-cta {
    text-align: center;
  }

  .final-cta__inner {
    max-width: 42rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final-cta h2 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    margin-block: 1rem 2.25rem;
  }
</style>
