---
import { services } from '../data/services';
import { withBase } from '../data/site';

interface Props {
  /** Slug of the service page being viewed, so its nav item is highlighted. */
  current?: string;
}

const { current } = Astro.props;

// All links are absolute (base-prefixed) so they work from every page,
// not just the homepage.
const navLinks = [
  ...services.map((service) => ({
    href: withBase(`services/${service.slug}/`),
    label: service.navLabel,
    isCurrent: service.slug === current,
  })),
  { href: withBase('#about'), label: 'About', isCurrent: false },
];
---

<header class="site-header" id="top">
  <div class="wrap site-header__inner">
    <a class="wordmark" href={withBase()} aria-label="The Clarity — home">THE CLARITY</a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a class="site-nav__link" href={link.href} aria-current={link.isCurrent ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn-primary nav-cta" href={withBase('#contact')}>Work with us</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  const setOpen = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('nav-open', open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(!nav?.classList.contains('is-open'));
  });

  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(38, 51, 47, 0.1);
  }

  /* The translucent blurred background sits on a pseudo-element: a
     backdrop-filter on the header itself would become the containing block
     for the fixed mobile menu, squashing it into the header's height. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(248, 247, 242, 0.9);
    backdrop-filter: blur(6px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
  }

  .wordmark {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-decoration: none;
    color: var(--color-deep-clarity);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: none;
    cursor: pointer;
    position: relative;
  }

  .nav-toggle__bar,
  .nav-toggle__bar::before,
  .nav-toggle__bar::after {
    content: '';
    position: absolute;
    width: 1.4rem;
    height: 1px;
    background: var(--color-deep-clarity);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle__bar::before { transform: translateY(-6px); }
  .nav-toggle__bar::after { transform: translateY(6px); }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bar {
    background: transparent;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar::before {
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar::after {
    transform: rotate(-45deg);
  }

  /* Mobile menu: full-screen panel. `visibility` keeps the hidden links out
     of the tab order and away from screen readers while the menu is closed. */
  .site-nav {
    position: fixed;
    inset: 4.3rem 0 0 0;
    background: var(--color-clarity-white);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    transform: translateY(-8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
  }

  .site-nav.is-open {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Only the text links — the "Work with us" button keeps its .btn styles. */
  .site-nav__link {
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-deep-clarity);
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current="page"] {
    text-decoration-line: underline;
    text-decoration-color: var(--color-warm-ochre);
  }

  .site-nav__link[aria-current="page"] {
    font-weight: 600;
    text-decoration-thickness: 2px;
  }

  .nav-cta {
    margin-top: 0.5rem;
  }

  /* Stop the page scrolling behind the open mobile menu. */
  @media (max-width: 61.99rem) {
    :global(html.nav-open) {
      overflow: hidden;
    }
  }

  @media (min-width: 62rem) {
    .nav-toggle {
      display: none;
    }

    .site-nav {
      position: static;
      inset: auto;
      flex-direction: row;
      gap: 2.5rem;
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      background: transparent;
      transition: none;
    }

    .site-nav ul {
      flex-direction: row;
      gap: 2rem;
    }

    .site-nav__link {
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 500;
    }

    .nav-cta {
      margin-top: 0;
    }
  }
</style>
