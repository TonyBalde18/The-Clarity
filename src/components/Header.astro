---
const navLinks = [
  { href: '#problem', label: 'The Problem' },
  { href: '#approach', label: 'Approach' },
  { href: '#services', label: 'Services' },
  { href: '#about', label: 'About' },
];
---

<header class="site-header" id="top">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="#top">THE CLARITY</a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <a class="btn btn-primary nav-cta" href="#contact">Work With Us</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(248, 247, 242, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(38, 51, 47, 0.1);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
  }

  .wordmark {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-decoration: none;
    color: var(--color-deep-clarity);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    position: relative;
  }

  .nav-toggle__bar,
  .nav-toggle__bar::before,
  .nav-toggle__bar::after {
    content: '';
    position: absolute;
    width: 1.4rem;
    height: 1px;
    background: var(--color-deep-clarity);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle__bar::before { transform: translateY(-6px); }
  .nav-toggle__bar::after { transform: translateY(6px); }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bar {
    background: transparent;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar::before {
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar::after {
    transform: rotate(-45deg);
  }

  .site-nav {
    position: fixed;
    inset: 4.3rem 0 0 0;
    background: var(--color-clarity-white);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .site-nav.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .site-nav a {
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-deep-clarity);
  }

  .nav-cta {
    margin-top: 0.5rem;
  }

  @media (min-width: 62rem) {
    .nav-toggle {
      display: none;
    }

    .site-nav {
      position: static;
      inset: auto;
      flex-direction: row;
      gap: 2.5rem;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      background: transparent;
    }

    .site-nav ul {
      flex-direction: row;
      gap: 2.25rem;
    }

    .site-nav a {
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 500;
    }

    .nav-cta {
      margin-top: 0;
    }
  }
</style>
