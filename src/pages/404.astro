---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, withBase } from '../data/site';
---

<Layout title={`Page not found | ${SITE_NAME}`} description="The page you were looking for could not be found." noindex>
  <Header />
  <main id="main" class="section not-found">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page doesn't exist.</h1>
      <p class="not-found__text">It may have moved, or the link may be out of date.</p>
      <a class="btn btn-primary" href={withBase()}>Back to the homepage</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    margin-block: 1rem 1.25rem;
  }

  .not-found__text {
    color: var(--color-muted-moss);
    margin-bottom: 2.25rem;
  }
</style>
